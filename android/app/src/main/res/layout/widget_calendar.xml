<?xml version="1.0" encoding="utf-8"?>
<!-- The calendar is drawn as a bitmap, in light and dark: layout-night shows the dark one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="google-sans-medium"
            android:paddingStart="8dp"
            android:singleLine="true"
            android:textColor="@color/w_on"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/w_ripple_round"
            android:contentDescription="@string/w_prev"
            android:src="@drawable/ic_w_prev"
            android:tint="@color/w_on_var" />

        <ImageButton
            android:id="@+id/btn_today"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/w_ripple_round"
            android:contentDescription="@string/w_today"
            android:src="@drawable/ic_w_today"
            android:tint="@color/w_on_var" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/w_ripple_round"
            android:contentDescription="@string/w_next"
            android:src="@drawable/ic_w_next"
            android:tint="@color/w_on_var" />

        <ImageButton
            android:id="@+id/btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/w_pill_primary"
            android:contentDescription="@string/w_new"
            android:src="@drawable/ic_w_add"
            android:tint="@color/w_on_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/img_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/w_calendar_name"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <ImageView
            android:id="@+id/img_dark"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/w_calendar_name"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
